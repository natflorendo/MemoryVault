# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# .env.example
# Rename this file to `.env` and replace all placeholder values with your actual credentials.

# --- Node Environment ---
# Set to "development", "production", or "test"
NODE_ENV="development"

# --- Database Configuration ---
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>"

# --- Hugging Face API Key ---
HF_API_KEY="your_huggingface_api_key_here"

# --- Authentication ---
# Secret used to sign JWT tokens (keep this safe in production)
JWT_SECRET="your_jwt_secret_here"

# --- Email Settings ---
# EMAIL_FROM should be the sender address (e.g. Gmail address)
# EMAIL_PASS is your app password (not your actual email password)
EMAIL_FROM="your_email@example.com"
EMAIL_PASS="your_email_app_password_here"

# --- Google OAuth Credentials ---
# These are required for Google login integration
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# --- Frontend URL ---
# Used to redirect OAuth back to the frontend
FRONTEND_URL="http://localhost:5173"